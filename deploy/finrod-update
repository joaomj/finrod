#!/usr/bin/env bash
# Install the latest Finrod GitHub release, restart Finrod, and roll back if it does not answer.
set -euo pipefail

REPO=joaomj/finrod
ROOT=$HOME/.local/share/finrod
RELEASES=$ROOT/releases
KEEP=3

mkdir -p "$RELEASES"
exec 9>"$ROOT/update.lock"
flock -n 9 || { echo "Another Finrod update is running." >&2; exit 1; }

port=$(sed -n 's/^FINROD_PORT=//p' "$ROOT/finrod.env" | tail -1)
port=${port:-8787}

healthy() {
  for _ in $(seq 30); do
    curl -sf -o /dev/null "http://127.0.0.1:$port/api/conversations" && return 0
    sleep 1
  done
  return 1
}

tag=$(curl -sfL --max-time 30 "https://api.github.com/repos/$REPO/releases/latest" |
  python3 -c 'import json,sys; print(json.load(sys.stdin)["tag_name"])')
[[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Unexpected release tag: $tag" >&2; exit 1; }
name=finrod-$tag
previous=$(readlink "$ROOT/current" 2>/dev/null || true)

if [[ $previous == "releases/$name" ]]; then
  echo "Finrod $tag is already installed."
  exit 0
fi

if [[ ! -d $RELEASES/$name ]]; then
  work=$(mktemp -d "$RELEASES/.download.XXXXXX")
  trap 'rm -rf "$work"' EXIT
  base=https://github.com/$REPO/releases/download/$tag
  curl -sfL --max-time 300 -o "$work/$name.tar.gz" "$base/$name.tar.gz"
  curl -sfL --max-time 30 -o "$work/$name.tar.gz.sha256" "$base/$name.tar.gz.sha256"
  (cd "$work" && sha256sum --quiet -c "$name.tar.gz.sha256")
  tar -C "$work" -xzf "$work/$name.tar.gz"
  mv "$work/$name" "$RELEASES/$name"
fi

ln -sfn "releases/$name" "$ROOT/.current.new" && mv -T "$ROOT/.current.new" "$ROOT/current"
systemctl --user restart finrod.service
if healthy; then
  echo "Finrod $tag is installed and answering."
else
  if [[ -z $previous ]]; then
    echo "Finrod $tag does not answer, and there is no previous release to go back to." >&2
    exit 1
  fi
  ln -sfn "$previous" "$ROOT/.current.new" && mv -T "$ROOT/.current.new" "$ROOT/current"
  systemctl --user restart finrod.service
  if healthy; then
    echo "Finrod $tag did not answer. Went back to $previous." >&2
  else
    echo "Finrod $tag did not answer, and $previous does not answer after going back either." >&2
  fi
  exit 1
fi

# Keep the newest releases, plus the one just replaced so a manual rollback stays possible.
ls -1t "$RELEASES" | grep '^finrod-v' | tail -n +$((KEEP + 1)) | while read -r old; do
  [[ releases/$old == "$previous" ]] || rm -rf "${RELEASES:?}/$old"
done
