{
  "name": "finrod",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test:telegram": "npm run build && node --test test/telegram.test.mjs",
    "start": "node dist/main.js",
    "feedback:export": "node dist/feedback-export.js",
    "test:voice": "npm run build && node --test test/voice.test.mjs",
    "test:install": "python3 test/install.test.py",
    "check:web": "tsc -p web/tsconfig.json",
    "build:web": "npm run check:web && node scripts/build-web.mjs",
    "web:serve": "node scripts/serve-web.mjs",
    "test:web": "npm run build:web && node --test test/web.test.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "grammy": "1.46.0",
    "markdown-it": "15.0.2",
    "pi-mcp-client": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/sql.js": "1.4.11",
    "esbuild": "0.28.2",
    "playwright-core": "1.61.1",
    "sql.js": "1.14.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.2.0"
  }
}
